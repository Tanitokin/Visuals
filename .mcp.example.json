{
  "mcpServers": {
    "elevenlabs": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": { "ELEVENLABS_API_KEY": "YOUR_ELEVENLABS_KEY" }
    },
    "replicate": {
      "command": "npx",
      "args": ["-y", "mcp-replicate"],
      "env": { "REPLICATE_API_TOKEN": "YOUR_REPLICATE_TOKEN" }
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./assets"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
